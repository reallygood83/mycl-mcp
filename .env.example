# Mycl production team must confirm these endpoints and issue a scoped user token.
MYCL_API_BASE_URL=https://api.example.invalid
MYCL_API_TOKEN=replace-with-a-scoped-user-token
MYCL_WEB_ORIGIN=https://mycl.io
# Optional local HTTP transport; loopback only, not a public OAuth service.
MCP_TRANSPORT=stdio
MCP_PORT=3000
MCP_BEARER_TOKEN=replace-with-a-separate-local-mcp-token
